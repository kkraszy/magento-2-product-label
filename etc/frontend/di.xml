<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- One plugin, two targets: the factory hands over the product, the block prints the labels after its <img> -->
    <type name="Magento\Catalog\Block\Product\ImageFactory">
        <plugin name="kkkonrad_productlabels" type="Kkkonrad\ProductLabels\Plugin\ProductImage"/>
    </type>
    <type name="Magento\Catalog\Block\Product\Image">
        <plugin name="kkkonrad_productlabels" type="Kkkonrad\ProductLabels\Plugin\ProductImage"/>
    </type>
</config>
